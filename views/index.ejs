<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body{
        font-family:  Geneva, Tahoma, sans-serif;
        text-align: center;
      }
      p{
        display: inline;
        font-weight: 800;
      }
      input{
        width: 400px;
        height: 30px;
        display: inline-block
      }
      button{
        height: 50px;
        width: 150px;
        font-size: 20px;
        margin-top:15px ;
        border-radius: 20px;
        background-color: yellow;
        color: red;
      }
      .userUrl{
        margin-top: 50px;
      }
    </style>
  </head>
  <body>
    <h1>URL Shortener</h1>
    <form method="post" action="/api/url">
      <p>Enter Valid URL :</p>
      <input type="text" name="url" placeholder="https://www.example.com"><br>
      <button type="submit">Genrate</button>
    </form>
    <div class="userUrl" >
      <h3>Your URLs</h3>
      <table>
        <tr>
          <th>Sr.No</th>
          <th>Short URL</th>
          <th>Redirect to URL</th>
        </tr>
        <tr></tr>
      </table>
    </div>
  </body>
</html>
